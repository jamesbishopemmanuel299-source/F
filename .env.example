# GEMINI_API_KEY: Required for Gemini AI API calls (prompt enhancement, songwriting, smart routing).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# KIE_API_KEY: API Key for KIE AI services (https://docs.kie.ai)
# Allows accessing KIE's video, image, music (Suno), and voice generation models.
KIE_API_KEY="MY_KIE_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION: Main backend infrastructure for Auth, Database & Cloud Storage
# Find these in your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# SUPABASE_SERVICE_ROLE_KEY: Privileged server-only key for administrative operations
# Never expose this key in frontend code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
